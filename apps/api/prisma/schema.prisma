generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String

  resumes     Resume[]
  aiFeedbacks AIFeedback[]
  usageStats  UsageStat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model Resume {
  id             String  @id @default(uuid())
  title          String
  documentId     String  @unique @default(uuid())
  targetJobTitle String?
  targetIndustry String?
  targetCompany  String?
  language       String  @default("en")
  templateId     String?
  themeColor     String  @default("#2563eb")

  firstName String
  lastName  String
  jobTitle  String?
  address   String?
  phone     String?
  email     String?
  linkedIn  String?
  github    String?
  portfolio String?
  photoUrl  String?
  workYears String?

  summary     String?

  atsScore    Float?
  atsFeedback String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  template Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  experiences    ResumeExperience[]
  educations     ResumeEducation[]
  skills         ResumeSkill[]
  certifications String[]
  languages      String[]

  versions   ResumeVersion[]
  aiSessions AISession[]

  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([documentId])
  @@index([createdAt])
}

model ResumeExperience {
  id               String  @id @default(uuid())
  resumeId         String
  resume           Resume  @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  title            String
  companyName      String
  city             String?
  state            String?
  startDate        String
  endDate          String?
  currentlyWorking Boolean @default(false)
  workSummary      String?
  aiGenerated      Boolean @default(false)
  sortOrder        Int     @default(0)

  @@index([resumeId])
}

model ResumeEducation {
  id             String @id @default(uuid())
  resumeId       String
  resume         Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  universityName String
  degree         String
  major          String?
  startDate      String
  endDate        String?
  description    String?
  sortOrder      Int    @default(0)

  @@index([resumeId])
}

model ResumeSkill {
  id       String @id @default(uuid())
  resumeId String
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  name     String
  rating   Int    @default(3)
  sortOrder Int   @default(0)

  @@index([resumeId])
}

model ResumeVersion {
  id        String   @id @default(uuid())
  resumeId  String
  resume    Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  version   Int
  snapshot  Json
  changelog String?
  createdBy String?

  createdAt DateTime @default(now())

  @@unique([resumeId, version])
  @@index([resumeId, createdAt])
}

model AISession {
  id         String   @id @default(uuid())
  resumeId   String
  resume     Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  action     String
  provider   String
  model      String
  input      Json
  output     Json?
  tokensUsed Int?
  duration   Int?
  error      String?

  createdAt DateTime @default(now())

  @@index([resumeId, createdAt])
  @@index([createdAt])
}

model AIFeedback {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeId       String
  action         String
  liked          Boolean
  originalOutput String
  modifiedOutput String?
  comment        String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([resumeId])
}

model Template {
  id          String   @id @default(uuid())
  name        String
  description String?
  thumbnail   String?
  category    String   @default("professional")
  isPremium   Boolean  @default(false)
  layout      String   @default("single")
  colors      String[] @default([])
  fonts       String[] @default([])
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)

  resumes Resume[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UsageStat {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  count     Int      @default(1)
  metadata  Json?

  createdAt DateTime @default(now())

  @@index([userId, action, createdAt])
}

model KnowledgeChunk {
  id        String   @id @default(uuid())
  source    String   @default("legacy")
  title     String
  category  String   @default("general")
  tags      String[] @default([])
  content   String
  embedding Float[]  @default([])
  metadata  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([source, title])
  @@index([category])
  @@index([createdAt])
}
